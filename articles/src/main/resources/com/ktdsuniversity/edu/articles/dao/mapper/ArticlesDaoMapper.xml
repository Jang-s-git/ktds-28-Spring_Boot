<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  <!--
  namespace란?
  	Mybatis가 실행해야하는 쿼리의 클래스의 경로를 작성
  	해당 클래스의 메소드와 mapper에 작성하는 쿼리가 매칭되어서 실행된다.
  	Mybatis가 생성하는 익명클래스의 원본
  -->
<mapper namespace="com.ktdsuniversity.edu.articles.dao.ArticlesDao">

	<!-- ArticlesDao 인터페이스에 있는 추상 메소드들을 구현 -->
	<!-- 
	long selectArticlesCount();
	<select id="selectArticlesCount" ==> 메소드의 이름
			paramterType="" ==> 메소드의 파라미터 타입, 없으면 생략
			resultType="long"> ==> 메소드의 반환 타입
	</select>
	-->
	
	<select id="selectArticlesCount" resultType="_long">
		SELECT COUNT(ID)
		  FROM ARTICLES
	</select>
	
	<select id="selectAllArticles"
			resultType="com.ktdsuniversity.edu.articles.vo.response.ArticlesVO">
		SELECT ID
	     , SUBJECT
	     , CONTENT
	     , EMAIL
	     , VIEW_CNT
	     , RECOMMEND_CNT
	     , DEL_YN
	     , TO_CHAR(CRT_DT, 'YYYY-MM-DD HH24:MI:SS') AS CRT_DT
	     , TO_CHAR(MDFY_DT, 'YYYY-MM-DD HH24:MI:SS') AS MDFY_DT
	     , FILE_SET_ID
	  FROM ARTICLES
	</select>
	
</mapper>